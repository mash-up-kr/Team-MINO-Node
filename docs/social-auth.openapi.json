    "/api/v1/users/me/identities": {
      "post": {
        "description": "현재 계정에 소셜 계정을 연결한다. 계정이 바뀌거나 토큰이 다시 발급되지는 않는다. 제공자마다 하나씩, 최대 세 개까지 연결할 수 있다.",
        "operationId": "AccountController_linkIdentity",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "const": "google"
                      },
                      "idToken": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["provider", "idToken"]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "const": "kakao"
                      },
                      "idToken": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["provider", "idToken"]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "const": "apple"
                      },
                      "idToken": {
                        "type": "string",
                        "minLength": 1
                      },
                      "authorizationCode": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["provider", "idToken", "authorizationCode"]
                  }
                ],
                "$schema": "http://json-schema.org/draft-07/schema#"
              },
              "examples": {
                "google": {
                  "value": {
                    "provider": "google",
                    "idToken": "example.google.id"
                  }
                },
                "kakao": {
                  "value": {
                    "provider": "kakao",
                    "idToken": "example.kakao.id"
                  }
                },
                "apple": {
                  "value": {
                    "provider": "apple",
                    "idToken": "example.apple.id",
                    "authorizationCode": "example-apple-code"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "추가된 로그인 수단",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": ["provider", "linkedAt"],
                      "properties": {
                        "provider": {
                          "type": "string",
                          "enum": ["google", "apple", "kakao"],
                          "example": "kakao"
                        },
                        "linkedAt": {
                          "type": "string",
                          "format": "date-time",
                          "example": "2026-11-25T12:00:00Z"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "요청 형식 오류 (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorCode": {
                      "type": "string",
                      "enum": ["VALIDATION_ERROR"],
                      "example": "VALIDATION_ERROR"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증 실패 (UNAUTHORIZED / TOKEN_EXPIRED) 또는 미등록 유저 (USER_NOT_REGISTERED)\n\n인증 실패 (UNAUTHORIZED / TOKEN_EXPIRED), 미등록 유저 (USER_NOT_REGISTERED) 또는 소셜 토큰 검증 실패 (INVALID_SOCIAL_TOKEN)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorCode": {
                      "type": "string",
                      "enum": [
                        "UNAUTHORIZED",
                        "TOKEN_EXPIRED",
                        "USER_NOT_REGISTERED",
                        "INVALID_SOCIAL_TOKEN"
                      ],
                      "example": "UNAUTHORIZED"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "다른 계정에 연결된 소셜 계정 (IDENTITY_ALREADY_LINKED) 또는 같은 제공자를 이미 연결함 (PROVIDER_ALREADY_LINKED)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorCode": {
                      "type": "string",
                      "enum": [
                        "IDENTITY_ALREADY_LINKED",
                        "PROVIDER_ALREADY_LINKED"
                      ],
                      "example": "IDENTITY_ALREADY_LINKED"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "소셜 제공자 일시 장애 (PROVIDER_UNAVAILABLE)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorCode": {
                      "type": "string",
                      "enum": ["PROVIDER_UNAVAILABLE"],
                      "example": "PROVIDER_UNAVAILABLE"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "로그인 수단 추가",
        "tags": ["user"]
      }
    },
    "/api/v1/users/me/identities/{provider}": {
      "delete": {
        "description": "지정한 제공자의 연결을 해제한다. 마지막 로그인 수단은 해제할 수 없다. Apple 연결을 해제하면 서버가 보관한 Apple 토큰도 폐기한다.",
