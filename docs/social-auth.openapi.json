    "/api/v1/auth/login": {
      "post": {
        "description": "소셜 ID 토큰을 검증하고 꾹 토큰 쌍을 발급한다. 처음 보는 소셜 계정이면 계정을 새로 만든다. 응답에는 프로필 등록 여부가 없으므로, 앱은 이어서 GET /users/me를 호출하고 401 USER_NOT_REGISTERED를 받으면 프로필 설정(POST /users)으로 보낸다.\n\n앱을 업데이트한 뒤 처음 로그인할 때만, 기기에 남아 있는 Firebase ID 토큰을 Bearer로 함께 보낸다. 그 익명 계정에 로그인 수단이 없으면 소셜 계정을 연결해서, 저장한 장소와 공동방을 그대로 이어 쓴다. 소셜 계정이 이미 다른 꾹 계정에 연결돼 있으면 그 계정으로 로그인하고, 익명 계정의 기록은 가져오지 않는다. 로그인에 성공하면 앱은 Firebase에서 signOut한다.",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "const": "google"
                      },
                      "idToken": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["provider", "idToken"]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "const": "kakao"
                      },
                      "idToken": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["provider", "idToken"]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "const": "apple"
                      },
                      "idToken": {
                        "type": "string",
                        "minLength": 1
                      },
                      "authorizationCode": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["provider", "idToken", "authorizationCode"]
                  }
                ],
                "$schema": "http://json-schema.org/draft-07/schema#"
              },
              "examples": {
                "google": {
                  "value": {
                    "provider": "google",
                    "idToken": "example.google.id"
                  }
                },
                "kakao": {
                  "value": {
                    "provider": "kakao",
                    "idToken": "example.kakao.id"
                  }
                },
                "apple": {
                  "value": {
                    "provider": "apple",
                    "idToken": "example.apple.id",
                    "authorizationCode": "example-apple-code"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "토큰 쌍. 신규 가입과 기존 계정 로그인 모두 같은 형태다.",
            "headers": {
              "Cache-Control": {
                "description": "자격증명 응답 캐싱 금지",
                "schema": {
                  "type": "string",
                  "enum": ["no-store"]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "accessToken",
                        "refreshToken",
                        "accessExpiresAt",
                        "refreshExpiresAt"
                      ],
                      "properties": {
                        "accessToken": {
                          "type": "string",
                          "description": "꾹 서버가 서명한 JWT. sub는 users.auth_uid, sid는 현재 세션이다.",
                          "example": "example.gguk.access"
                        },
                        "refreshToken": {
                          "type": "string",
                          "description": "불투명 토큰. 갱신할 때마다 교체되므로 받은 값을 저장한다.",
                          "example": "example-opaque-refresh"
                        },
                        "accessExpiresAt": {
                          "type": "string",
                          "format": "date-time",
                          "description": "발급 후 30분",
                          "example": "2026-11-25T12:30:00Z"
                        },
                        "refreshExpiresAt": {
                          "type": "string",
                          "format": "date-time",
                          "description": "발급 또는 마지막 갱신 후 90일",
                          "example": "2027-02-23T12:00:00Z"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "요청 형식 오류 (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorCode": {
                      "type": "string",
                      "enum": ["VALIDATION_ERROR"],
                      "example": "VALIDATION_ERROR"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "소셜 토큰 검증 실패 (INVALID_SOCIAL_TOKEN) 또는 첨부한 Firebase 토큰이 유효하지 않음 (UNAUTHORIZED / TOKEN_EXPIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorCode": {
                      "type": "string",
                      "enum": [
                        "INVALID_SOCIAL_TOKEN",
                        "UNAUTHORIZED",
                        "TOKEN_EXPIRED"
                      ],
                      "example": "INVALID_SOCIAL_TOKEN"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "소셜 제공자 일시 장애 (PROVIDER_UNAVAILABLE)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorCode": {
                      "type": "string",
                      "enum": ["PROVIDER_UNAVAILABLE"],
                      "example": "PROVIDER_UNAVAILABLE"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearer": []
          }
        ],
        "summary": "소셜 로그인",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "access 토큰과 refresh 토큰을 함께 교체한다. 직전 refresh 토큰으로 60초 안에 다시 요청하면 같은 토큰 쌍을 돌려준다. 응답을 받지 못했거나 본앱과 공유 익스텐션이 동시에 갱신하는 경우를 위한 것이다. 그보다 오래된 토큰을 다시 쓰면 세션을 폐기한다.",
        "operationId": "AuthController_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["refreshToken"],
                "$schema": "http://json-schema.org/draft-07/schema#"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "새 토큰 쌍",
            "headers": {
              "Cache-Control": {
                "description": "자격증명 응답 캐싱 금지",
                "schema": {
                  "type": "string",
                  "enum": ["no-store"]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "accessToken",
                        "refreshToken",
                        "accessExpiresAt",
                        "refreshExpiresAt"
                      ],
                      "properties": {
                        "accessToken": {
                          "type": "string",
                          "description": "꾹 서버가 서명한 JWT. sub는 users.auth_uid, sid는 현재 세션이다.",
                          "example": "example.gguk.access"
                        },
                        "refreshToken": {
                          "type": "string",
                          "description": "불투명 토큰. 갱신할 때마다 교체되므로 받은 값을 저장한다.",
                          "example": "example-opaque-refresh"
                        },
                        "accessExpiresAt": {
                          "type": "string",
                          "format": "date-time",
                          "description": "발급 후 30분",
                          "example": "2026-11-25T12:30:00Z"
                        },
                        "refreshExpiresAt": {
                          "type": "string",
                          "format": "date-time",
                          "description": "발급 또는 마지막 갱신 후 90일",
                          "example": "2027-02-23T12:00:00Z"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "요청 형식 오류 (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorCode": {
                      "type": "string",
                      "enum": ["VALIDATION_ERROR"],
                      "example": "VALIDATION_ERROR"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "refresh 토큰이 만료됐거나 폐기됐거나 유효하지 않음 (INVALID_REFRESH_TOKEN). 다시 로그인해야 한다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorCode": {
                      "type": "string",
                      "enum": ["INVALID_REFRESH_TOKEN"],
                      "example": "INVALID_REFRESH_TOKEN"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
