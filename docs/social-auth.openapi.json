{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/users": {
      "post": {
        "description": "익명 인증 토큰의 uid로 등록한다. 개인방(내 장소) 생성이 같은 흐름에서 처리되며 응답에는 포함하지 않는다.",
        "operationId": "UserController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nickname": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 15,
                    "pattern": "^[\\uAC00-\\uD7A3A-Za-z]+$"
                  },
                  "avatar": {
                    "type": "object",
                    "properties": {
                      "color": {
                        "enum": [
                          "red",
                          "red_orange",
                          "orange",
                          "lime",
                          "green",
                          "cyan",
                          "violet",
                          "pink",
                          "blue",
                          "brown",
                          "light_blue",
                          "purple",
                          "gray"
                        ],
                        "type": "string"
                      }
                    },
                    "required": ["color"]
                  }
                },
                "required": ["nickname", "avatar"],
                "$schema": "http://json-schema.org/draft-07/schema#"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "nickname": {
                          "type": "string",
                          "example": "꾹이"
                        },
                        "avatar": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "color": {
                              "type": "string",
                              "enum": [
                                "red",
                                "red_orange",
                                "orange",
                                "lime",
                                "green",
                                "cyan",
                                "violet",
                                "pink",
                                "blue",
                                "brown",
                                "light_blue",
                                "purple",
                                "gray"
                              ],
                              "example": "red"
                            }
                          }
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "identities": {
                          "type": "array",
                          "maxItems": 3,
                          "description": "연결된 로그인 수단. 제공자별 최대 한 개이고, 구버전 앱의 익명 유저는 빈 배열이다.",
                          "items": {
                            "type": "object",
                            "required": ["provider", "linkedAt"],
                            "properties": {
                              "provider": {
                                "type": "string",
                                "enum": ["google", "apple", "kakao"],
                                "example": "kakao"
                              },
                              "linkedAt": {
                                "type": "string",
                                "format": "date-time",
                                "example": "2026-11-25T12:00:00Z"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증 실패 (UNAUTHORIZED / TOKEN_EXPIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorCode": {
                      "type": "string",
                      "enum": ["UNAUTHORIZED", "TOKEN_EXPIRED"],
                      "example": "UNAUTHORIZED"
                    },
                    "message": {
                      "type": "string",
                      "example": "인증 정보가 없습니다."
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "이미 등록된 계정 (USER_ALREADY_REGISTERED)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorCode": {
                      "type": "string",
                      "example": "USER_ALREADY_REGISTERED"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "유저 등록 (+ 개인방 자동 생성)",
        "tags": ["user"]
      }
    },
