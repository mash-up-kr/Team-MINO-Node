{
  "name": "team-mino",
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "main": "dist/src/main",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "biome check .",
    "check:staged": "nano-staged --bail",
    "db:generate": "bun run scripts/with-env.ts -- drizzle-kit generate",
    "db:migrate": "bun run scripts/with-env.ts -- drizzle-kit migrate",
    "db:schema-init": "bun run scripts/with-env.ts -- bun run scripts/db-schema-init.ts",
    "db:studio": "bun run scripts/with-env.ts -- drizzle-kit studio",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "postinstall": "simple-git-hooks",
    "start:local": "APP_ENV=local CLOUD_TASKS_MODE=local bun run scripts/with-env.ts -- nest start --watch --exec bun",
    "start:prod": "./dist/server",
    "test": "bun run test:unit && bun run test:e2e",
    "test:e2e": "bun test --env-file=.env.test --preload ./e2e/setup.ts e2e/",
    "test:unit": "bun test --env-file=.env.test src/",
    "test:watch": "bun test --env-file=.env.test --watch src/",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@ai-sdk/google-vertex": "^4.0.147",
    "@ai-sdk/valibot": "^2.0.31",
    "@google-cloud/tasks": "^6.2.3",
    "@google-cloud/storage": "^7.21.0",
    "@kiyasov/platform-hono": "^2.0.3",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@sentry/bun": "10.59.0",
    "@valibot/to-json-schema": "^1.7.1",
    "ai": "^6.0.208",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^10.9.0",
    "nestjs-pino": "^4.6.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@google-cloud/secret-manager": "^6.3.0",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.24",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "17.10.0-beta.17",
    "nano-staged": "^1.0.2",
    "pino-pretty": "^13.1.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run check:staged",
    "pre-push": "bun run typecheck && bun run --no-env-file test"
  },
  "nano-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": "biome check --write"
  },
  "trustedDependencies": [
    "@embedded-postgres/darwin-arm64",
    "@embedded-postgres/darwin-x64",
    "@embedded-postgres/linux-arm64",
    "@embedded-postgres/linux-x64"
  ]
}
