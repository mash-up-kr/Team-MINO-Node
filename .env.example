# ────────────────────────────────────────────────────────────────
# 이 프로젝트의 env 단일 출처는 GCP Secret Manager 입니다.
# 평상시 로컬 실행은 .env가 아니라 SM에서 받아옵니다:
#
#   bun run start:local      # APP_ENV=local → team-mino-env-local 시크릿을 fetch
#
# (로컬에서 SM을 쓰려면 먼저: gcloud auth application-default login)
#
# 아래 값들은 "오프라인/전환기" 탈출구용입니다. APP_CONFIG_SOURCE=env 로 두면
# SM을 건너뛰고 이 .env(+process.env)를 그대로 사용합니다.
# ────────────────────────────────────────────────────────────────

# SM을 건너뛰고 로컬 .env를 쓰려면 주석 해제:
# APP_CONFIG_SOURCE=env

# 환경 선택(local | prod). 시크릿 이름 team-mino-env-${APP_ENV} 로 매핑.
APP_ENV=local
# GCP_PROJECT=team-mino-prod        # 생략 시 기본값
# GCP_ENV_SECRET=team-mino-env-local  # 생략 시 APP_ENV로 규칙 생성

NODE_ENV=development
PORT=3000

# DB 연결. 런타임·마이그레이션 공용.
# 로컬: docker compose의 postgres 사용(TLS 불필요).
# Supabase(prod): Direct connection 우선(상주 서버라 풀러 불필요 + 레이턴시↓).
#   postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres?sslmode=require
# (Cloud Run에서 Direct가 IPv6 이슈로 안 닿으면 session pooler로 폴백)
#   postgresql://postgres.<ref>:<pw>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# ※ 트랜잭션 풀러(6543)는 사용하지 않습니다.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/team_mino

# 접근할 스키마(환경 분리). 미설정 시 develop. prod 시크릿 값에서만 production 으로.
# DATABASE_SCHEMA=develop

# 인스턴스당 최대 커넥션 수(기본 5).
DB_POOL_SIZE=5

# docker-compose의 postgres 컨테이너 설정용
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=team_mino
