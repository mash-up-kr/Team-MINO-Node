# env 단일 출처는 GCP Secret Manager. 평상시 로컬은 `bun run start:local`로 SM에서 받아옵니다.
# (최초 1회: gcloud auth application-default login)
#
# 아래는 SM을 건너뛰는 탈출구(오프라인/전환기)입니다. APP_CONFIG_SOURCE=env 로 켜면 사용됩니다.

# APP_CONFIG_SOURCE=env

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/team_mino
# DATABASE_SCHEMA=develop
DB_POOL_SIZE=5

# docker-compose의 postgres 컨테이너 설정용
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=team_mino

GOOGLE_CLOUD_PROJECT=
GOOGLE_VERTEX_LOCATION=global
KAKAO_REST_API_KEY=changeme
