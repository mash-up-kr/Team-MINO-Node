# env 단일 출처는 GCP Secret Manager. 앱이 직접 가져오지 않고 APP_ENV_DOTENV로 주입받습니다.
#   로컬: bun run start:local (scripts/with-env.ts 가 ADC로 조회)
#   prod: Cloud Run --set-secrets
# 최초 1회: gcloud auth application-default login
#
# 아래는 주입 없이 로컬 파일만으로 띄울 때 쓰는 탈출구입니다.

# APP_CONFIG_SOURCE=env

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/team_mino
# DATABASE_SCHEMA=develop
DB_POOL_SIZE=5

# docker-compose의 postgres 컨테이너 설정용
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=team_mino

GOOGLE_CLOUD_PROJECT=team-mino-prod
# Firebase Authentication 프로젝트 ID. ID 토큰의 iss/aud 검증 기준값이며,
# 생략하면 GOOGLE_CLOUD_PROJECT를 그대로 쓴다(같은 GCP 프로젝트에 얹은 경우).
# FIREBASE_PROJECT_ID=team-mino-prod
GOOGLE_VERTEX_LOCATION=global
KAKAO_REST_API_KEY=changeme

# Optional error monitoring (APP_CONFIG_SOURCE=env 전용; prod는 Secret Manager에 저장)
# SENTRY_DSN=https://public@example.ingest.sentry.io/project-id
# SENTRY_RELEASE=git-commit-sha

# DB keep-alive (prod 전용). 미설정 시 keep-alive만 꺼지고 서버는 그대로 뜬다.
# SUPABASE_KEEP_ALIVE_URL=https://<project-ref>.supabase.co/auth/v1/health
# SUPABASE_API_KEY=sb_publishable_xxx

# 인스타 로그아웃 GraphQL의 persisted query id (필수). 인스타가 주기적으로 교체하므로 그때 갱신.
# 낡아도 게시글 HTML 경로로 자동 폴백하니 장애로는 이어지지 않는다.
INSTAGRAM_DOC_ID=27130156389949648

# Cloud Tasks 비동기 장소 추출 (필수). LOCATION/QUEUE는 infra/src/resources/tasks.ts와 일치해야 함.
# 운영 Secret에는 기본값(cloud)을 사용하거나 생략하세요.
CLOUD_TASKS_MODE=cloud
# Cloud Tasks OIDC invoker SA 이메일.
CLOUD_TASKS_INVOKER_EMAIL=team-mino-prod-tasks-invoker@team-mino-prod.iam.gserviceaccount.com
# Cloud Tasks가 호출할 API/Cloud Run service URL. 로컬에서는 Public API와 Internal endpoint가 같은 서버(3000 포트)에 있습니다.
APP_BASE_URL=http://localhost:3000
CLOUD_TASKS_LOCATION=asia-northeast3
CLOUD_TASKS_QUEUE=team-mino-prod-place-extraction

# ── 초대 링크(유니버설 링크 / App Links) ────────────────────────────────
# 아래 값은 전부 앱팀에서 받아야 한다. 비어 있으면 해당 플랫폼의
# .well-known 응답이 404가 되고, 앱 부팅은 막지 않는다.

# 초대 링크가 올라가는 오리진. api.gguk.org가 아니라 apex다.
APP_WEB_ORIGIN=https://gguk.org

# [앱팀] Apple Developer > Membership 의 Team ID (10자)
IOS_TEAM_ID=D2DRA3F792
# [앱팀] Bundle ID. dev/staging 번들이 따로 있으면 쉼표로 모두
IOS_BUNDLE_IDS=com.mashup.teamMino
# [앱팀] App Store Connect 에 앱 등록 시 발급되는 숫자 ID
IOS_APP_STORE_ID=6806306129
# [협의] iOS 커스텀 스킴. 카카오톡 인앱 브라우저에서 앱을 여는 유일한 수단
IOS_URL_SCHEME=gguk

# [앱팀] Android 배포 패키지명
ANDROID_PACKAGE_NAME=com.mino.gguk
# [앱팀] 배포 패키지의 SHA-256 지문 — 업로드 키, Play 앱 서명 키 순으로 쉼표
#        Play 앱 서명 키는 Play Console > 설정 > 앱 무결성 > 앱 서명 키 인증서.
#        이걸 빼면 프로덕션 빌드에서만 링크가 열리지 않는다.
ANDROID_SHA256_FINGERPRINTS=4F:73:8D:15:9D:F6:EE:86:E1:07:EB:6E:25:6E:8C:85:63:54:8B:96:22:8D:13:E6:A9:FA:75:AF:39:75:70:05,C7:55:56:43:7F:11:41:04:51:80:7A:62:BB:36:44:95:44:ED:05:09:74:31:28:E3:07:A4:25:32:8F:46:A2:8E
# [앱팀] 디버그 빌드의 패키지명. 배포와 applicationId가 달라 별도 엔트리가 필요하다.
ANDROID_DEBUG_PACKAGE_NAME=com.mino.gguk.qa
ANDROID_DEBUG_SHA256_FINGERPRINTS=A1:43:2E:69:2B:0D:35:58:AD:38:F9:43:D2:DC:E0:27:82:FA:FD:9E:FD:DE:92:1F:AF:44:32:55:C9:8E:A2:DD
# [디자인] 공유 카드 이미지. 1200x630 PNG/JPG. 카톡·iMessage·X 공용.
#          카카오톡이 OG를 캐싱하므로 첫 배포 전에 채울 것
# OG_IMAGE_URL=
