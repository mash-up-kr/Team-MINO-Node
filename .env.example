# env 단일 출처는 GCP Secret Manager. 앱이 직접 가져오지 않고 APP_ENV_DOTENV로 주입받습니다.
#   로컬: bun run start:local (scripts/with-env.ts 가 ADC로 조회)
#   prod: Cloud Run --set-secrets
# 최초 1회: gcloud auth application-default login
#
# 아래는 주입 없이 로컬 파일만으로 띄울 때 쓰는 탈출구입니다.

# APP_CONFIG_SOURCE=env

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/team_mino
# DATABASE_SCHEMA=develop
DB_POOL_SIZE=5

# docker-compose의 postgres 컨테이너 설정용
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=team_mino

GOOGLE_CLOUD_PROJECT=team-mino-prod
GOOGLE_VERTEX_LOCATION=global
KAKAO_REST_API_KEY=changeme

# Optional error monitoring (APP_CONFIG_SOURCE=env 전용; prod는 Secret Manager에 저장)
# SENTRY_DSN=https://public@example.ingest.sentry.io/project-id
# SENTRY_RELEASE=git-commit-sha

# DB keep-alive (prod 전용). 미설정 시 keep-alive만 꺼지고 서버는 그대로 뜬다.
# SUPABASE_KEEP_ALIVE_URL=https://<project-ref>.supabase.co/auth/v1/health
# SUPABASE_API_KEY=sb_publishable_xxx

# Instagram 비공개 GraphQL 호출용 (필수). 인스타가 토큰/구조를 바꾸면 이 값들을 갱신.
# 비로그인 접근은 GET /graphql/query/ 경로만 허용됨(/api/graphql POST는 차단됨).
INSTAGRAM_GRAPHQL_ENDPOINT=https://www.instagram.com/graphql/query/
INSTAGRAM_DOC_ID=10015901848480474
INSTAGRAM_APP_ID=936619743392459
INSTAGRAM_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# Cloud Tasks 비동기 장소 추출 (필수). LOCATION/QUEUE는 infra/src/resources/tasks.ts와 일치해야 함.
# APP_BASE_URL은 Cloud Tasks가 호출할 API/Cloud Run service URL, INVOKER_EMAIL은 Cloud Tasks OIDC invoker SA 이메일.
# `bun run start:local`은 CLOUD_TASKS_MODE=local을 주입해 실제 enqueue 없이 Postman 수동 워커 호출을 허용합니다.
# 운영 Secret에는 기본값(cloud)을 사용하거나 생략하세요.
CLOUD_TASKS_MODE=cloud
CLOUD_TASKS_INVOKER_EMAIL=team-mino-prod-tasks-invoker@team-mino-prod.iam.gserviceaccount.com
# 로컬에서는 Public API와 Internal endpoint가 같은 서버(3000 포트)에 있습니다.
APP_BASE_URL=http://localhost:3000
CLOUD_TASKS_LOCATION=asia-northeast3
CLOUD_TASKS_QUEUE=team-mino-prod-place-extraction
